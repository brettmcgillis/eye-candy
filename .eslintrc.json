{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended",
    "airbnb",
    "plugin:@typescript-eslint/recommended",
    "prettier",
    "plugin:import/errors",
    "plugin:import/warnings",
    "plugin:import/recommended",
    "plugin:prettier/recommended"
  ],
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "plugins": ["prettier", "unused-imports"],
  "rules": {
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "react/prop-types": "off",
    "react/no-unknown-property": "off",
    "react/jsx-props-no-spreading": "off",
    "react/jsx-filename-extension": [
      1,
      {
        "extensions": [".js", ".jsx"]
      }
    ],
    "import/named": "error",
    "import/default": "error",
    "import/no-named-as-default": "error",
    "import/no-named-as-default-member": "error",
    "prettier/prettier": "error",
    "unused-imports/no-unused-imports": "error",
    "unused-imports/no-unused-vars": [
      "warn",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_"
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**/*.{js,jsx,ts,tsx}"],
      "excludedFiles": ["src/dev/**/*", "src/app/App.jsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@dev", "@dev/*", "**/dev/**"],
                "message": "Dev tooling is local-only and may only be mounted by src/app/App.jsx."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/dev/tools/colors/**/*.{js,jsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/gltfjsx/**",
                  "**/iconography/**",
                  "**/loaderPatterns/**",
                  "**/rorschach/**"
                ],
                "message": "A dev tool may not import another tool's internals. Promote shared code to src/dev/shell (UI) or a shared src/dev folder (behavior)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/dev/tools/gltfjsx/**/*.{js,jsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/colors/**",
                  "**/iconography/**",
                  "**/loaderPatterns/**",
                  "**/rorschach/**"
                ],
                "message": "A dev tool may not import another tool's internals. Promote shared code to src/dev/shell (UI) or a shared src/dev folder (behavior)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/dev/tools/iconography/**/*.{js,jsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/colors/**",
                  "**/gltfjsx/**",
                  "**/loaderPatterns/**",
                  "**/rorschach/**"
                ],
                "message": "A dev tool may not import another tool's internals. Promote shared code to src/dev/shell (UI) or a shared src/dev folder (behavior)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/dev/tools/loaderPatterns/**/*.{js,jsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/colors/**",
                  "**/gltfjsx/**",
                  "**/iconography/**",
                  "**/rorschach/**"
                ],
                "message": "A dev tool may not import another tool's internals. Promote shared code to src/dev/shell (UI) or a shared src/dev folder (behavior)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/dev/tools/rorschach/**/*.{js,jsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/colors/**",
                  "**/gltfjsx/**",
                  "**/iconography/**",
                  "**/loaderPatterns/**"
                ],
                "message": "A dev tool may not import another tool's internals. Promote shared code to src/dev/shell (UI) or a shared src/dev folder (behavior)."
              },
              {
                "group": ["@modules/rorschach/*", "**/modules/rorschach/*"],
                "message": "Import the Rorschach kernel through its @modules/rorschach barrel, never a file inside it. See docs/rorschach-pipeline.md."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/modules/rorschach/**/*.{js,mjs}"],
      "rules": {
        "import/extensions": [
          "error",
          "ignorePackages",
          {
            "js": "never",
            "jsx": "never",
            "mjs": "always"
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@app",
                  "@app/*",
                  "@components",
                  "@components/*",
                  "@dev",
                  "@dev/*",
                  "**/dev/**",
                  "**/scenes/**",
                  "react",
                  "react-dom",
                  "react-*",
                  "leva",
                  "@react-three/*"
                ],
                "message": "The Rorschach kernel is renderer-agnostic: no React, R3F, Leva, DOM, scene or dev-tooling imports. See docs/rorschach-pipeline.md."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/scenes/WebGPU/Rorschach/**/*.{js,jsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@dev", "@dev/*", "**/dev/**"],
                "message": "Dev tooling is local-only and may only be mounted by src/app/App.jsx."
              },
              {
                "group": ["@modules/rorschach/*", "**/modules/rorschach/*"],
                "message": "Import the Rorschach kernel through its @modules/rorschach barrel, never a file inside it. See docs/rorschach-pipeline.md."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "ecmaVersion": 2020,
        "sourceType": "module",
        "ecmaFeatures": {
          "jsx": true
        }
      },
      "extends": ["plugin:@typescript-eslint/recommended"],
      "rules": {
        "react/jsx-filename-extension": [
          1,
          {
            "extensions": [".tsx"]
          }
        ],
        "import/extensions": [
          "error",
          "ignorePackages",
          {
            "ts": "never",
            "tsx": "never"
          }
        ]
      }
    },
    {
      "files": ["vite.config.*", "vitest.config.*", "src/dev/server/**/*.js"],
      "env": {
        "node": true
      },
      "rules": {
        "import/no-extraneous-dependencies": [
          "error",
          {
            "devDependencies": true
          }
        ],
        "import/no-unresolved": "off",
        "import/extensions": [
          "error",
          "ignorePackages",
          {
            "js": "never",
            "jsx": "never",
            "mjs": "always"
          }
        ]
      }
    }
  ],
  "settings": {
    "import/resolver": {
      "exports": {},
      "node": {
        "extensions": [".js", ".jsx", ".ts", ".tsx"],
        "moduleDirectory": ["node_modules"]
      },
      "alias": {
        "map": [
          ["@app", "./src/app"],
          ["@components", "./src/components"],
          ["@dev", "./src/dev"],
          ["@elements", "./src/components/elements"],
          ["@hooks", "./src/hooks"],
          ["@materials", "./src/components/materials"],
          ["@modules", "./src/modules"],
          ["@postprocessing", "./src/components/postprocessing"],
          ["@presets", "./src/presets"],
          ["@scenes", "./src/components/scenes"],
          ["@store", "./src/store"],
          ["@styles", "./src/styles"],
          ["@utils", "./src/utils"]
        ],
        "extensions": [".js", ".jsx", ".ts", ".tsx", ".json"]
      }
    }
  },
  "globals": {
    "__APP_VERSION__": "readonly"
  }
}
