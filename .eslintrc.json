{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended",
    "airbnb",
    "plugin:@typescript-eslint/recommended",
    "prettier",
    "plugin:import/errors",
    "plugin:import/warnings",
    "plugin:import/recommended",
    "plugin:prettier/recommended"
  ],
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "plugins": ["prettier", "unused-imports"],
  "rules": {
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "react/prop-types": "off",
    "react/no-unknown-property": "off",
    "react/jsx-props-no-spreading": "off",
    "react/jsx-filename-extension": [
      1,
      {
        "extensions": [".js", ".jsx"]
      }
    ],
    "import/named": "error",
    "import/default": "error",
    "import/no-named-as-default": "error",
    "import/no-named-as-default-member": "error",
    "prettier/prettier": "error",
    "unused-imports/no-unused-imports": "error",
    "unused-imports/no-unused-vars": [
      "warn",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_"
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**/*.{js,jsx,ts,tsx}"],
      "excludedFiles": ["src/dev/**/*", "src/app/App.jsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@dev", "@dev/*", "**/dev/**"],
                "message": "Dev tooling is local-only and may only be mounted by src/app/App.jsx."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/dev/tools/apollian/**/*.{js,jsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/blockParty/**",
                  "**/brutalist/**",
                  "**/cataloggr/**",
                  "**/colors/**",
                  "**/darkroom/**",
                  "**/flora/**",
                  "**/fungi/**",
                  "**/gltfjsx/**",
                  "**/glyphs/**",
                  "**/hyperCubes/**",
                  "**/iconography/**",
                  "**/inventory/**",
                  "**/isoLines/**",
                  "**/isoLinesRelief/**",
                  "**/kumiko/**",
                  "**/loaderPatterns/**",
                  "**/nestingBoxes/**",
                  "**/networkTest/**",
                  "**/projectionMapping/**",
                  "**/pushComesToShove/**",
                  "**/rorschach/**",
                  "**/rugPull/**",
                  "**/subdivision/**",
                  "**/trucheterie/**"
                ],
                "message": "A dev tool may not import another tool's internals. Promote shared code to src/dev/shell (UI) or a shared src/dev folder (behavior)."
              },
              {
                "group": [
                  "@modules/apollian/*",
                  "**/modules/apollian/*",
                  "@modules/apollianRender/*",
                  "**/modules/apollianRender/*"
                ],
                "message": "Import the Apollian kernel through its @modules/apollian barrel, never a file inside it. See docs/apollian-pipeline.md."
              }
            ]
          }
        ]
      }
    },
