{
  "private": true,
  "name": "eye-candy",
  "version": "0.1.0",
  "homepage": "https://brettmcgillis.github.io/eye-candy",
  "scripts": {
    "audio:normalize": "node scripts/normalize-audio.mjs",
    "audio:sprites": "node scripts/extract-sprites.mjs",
    "build": "vite build",
    "bump:major": "npm version major",
    "bump:minor": "npm version minor",
    "bump:patch": "npm version patch",
    "deploy": "gh-pages -d dist",
    "dev": "vite --host",
    "dev:https": "vite --host --mode https",
    "format:check": "prettier .",
    "format:fix": "prettier --write .",
    "format:package:check": "prettier-package-json",
    "format:package:fix": "prettier-package-json --write",
    "gltf:compress": "gltf-transform draco",
    "gltf:compress:textures": "gltf-transform uastc --level 4 --rdo 4 --slots '{metalness,roughness}' --zstd 18 --verbose",
    "gltf:inspect": "gltf-transform inspect",
    "gltf:optimize": "gltf-transform optimize --compress draco",
    "gltf:resize": "gltf-transform resize --width 2048 --height 2048",
    "gltf:validate": "gltf-transform validate",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "occluder:sdf": "node scripts/bake-occluder-sdf.mjs",
    "predeploy": "npm run build",
    "preview": "vite preview",
    "publish": "npm run build && npm run deploy",
    "publish:major": "npm run bump:major && npm run publish",
    "publish:minor": "npm run bump:minor && npm run publish",
    "publish:patch": "npm run bump:patch && npm run publish",
    "push:tags": "git push --follow-tags",
    "release:major": "npm run publish:major && npm run push:tags",
    "release:minor": "npm run publish:minor && npm run push:tags",
    "release:patch": "npm run publish:patch && npm run push:tags",
    "rorschach:check": "node scripts/rorschach-check.mjs",
    "rorschach:generate": "node scripts/rorschach-generate.mjs",
    "rorschach:video": "node scripts/rorschach-video.mjs",
    "start": "npm run dev",
    "start-https": "npm run dev:https"
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@dgreenheck/three-pinata": "^2.0.1",
    "@dimforge/rapier3d-compat": "0.19.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@mediapipe/hands": "^0.4.1675469240",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@react-spring/three": "^10.0.3",
    "@react-spring/web": "^10.0.3",
    "@react-three/csg": "^3.2.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "@react-three/rapier-addons": "^5.0.0",
    "@sparkjsdev/spark": "^0.1.10",
    "@strudel.cycles/core": "^0.10.0",
    "@strudel.cycles/webaudio": "^0.10.0",
    "@strudel/web": "^1.3.0",
    "@theatre/core": "^0.7.2",
    "@theatre/studio": "^0.7.2",
    "bootstrap": "^5.3.2",
    "gh-pages": "^6.1.0",
    "howler": "^2.2.4",
    "html2canvas": "^1.4.1",
    "leva": "^0.10.1",
    "maath": "^0.10.8",
    "partysocket": "1.1.18",
    "postprocessing": "^6.38.2",
    "react": "^19.0.0",
    "react-bootstrap": "^2.9.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.15.0",
    "three": "^0.185.0",
    "three-mesh-bvh": "^0.9.9",
    "three-msdf-text-utils": "^1.5.0",
    "three-plotter-renderer": "^1.1.1",
    "three-stdlib": "^2.36.1",
    "three-subdivide": "^1.1.5",
    "tone": "^15.1.22",
    "tsl-textures": "^3.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@gltf-transform/cli": "^4.3.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^8.56.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-exports": "^1.0.0-beta.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "gltfjsx": "^6.5.3",
    "jsdom": "^29.1.1",
    "jsdom-global": "^3.0.2",
    "partykit": "0.0.115",
    "prettier": "^3.2.4",
    "prettier-package-json": "^2.8.0",
    "sharp": "^0.34.5",
    "vite": "^7.3.1",
    "webgpu": "^0.4.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
